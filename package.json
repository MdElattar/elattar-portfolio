{
  "name": "cyber-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "design:guard": "node scripts/design-guard.mjs",
    "design:guard:update": "node scripts/design-guard.mjs --update",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cyber-portfolio \"node --test --test-concurrency=1 tests/firestore*.rules.test.mjs\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "cloudinary": "^2.10.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
