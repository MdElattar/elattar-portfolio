# Client-safe Firebase config (public identifiers, not secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Client-safe Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only. Never use these with a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GITHUB_ACCESS_TOKEN=

# Firebase Admin SDK (server-only). Use either a service-account.json file locally
# or these environment variables in Vercel. Keep the private key escaped ("\n").
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
ADMIN_EMAILS=

# Rate limiting (server-only). Falls back to in-memory limits when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional). Server and browser DSNs are separate.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# The old browser-exposed GitHub token was removed; use GITHUB_ACCESS_TOKEN server-side only.
